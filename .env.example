# Discord login secret for the bot account.
BOT_TOKEN=insert_token_here

# The single Discord user ID treated as bot owner.
# permission checks in core/iam.py. owner_only() decorator.
OWNER_ID=insert_owner_id_here

# Role name that grants admin-level permission in checks.
# permission checks in core/iam.py. admin_only() decorator.
ADMIN_ROLE_NAME=admin_role_name

# Optional: default channel ID for HKO sudden-change weather alerts.
HKO_ALERT_CHANNEL_ID=

# Optional: how often (minutes) the HKO watcher checks for sudden change.
HKO_ALERT_INTERVAL_MINUTES=5